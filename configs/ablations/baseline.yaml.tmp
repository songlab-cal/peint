# Published PEINT baseline — the reference point for all referee #3.3 ablations.
# Effective batch matches the published training (confirmed by Antoine): ~250k tokens
# / 768 sequences per gradient update. The published run used 4 GPUs x accumulate 6;
# here we use 2 GPUs x accumulate 12 (same 768 = 32*12*2), because the yss partition
# schedules 2 A100s promptly while 4 contiguous A100s were days out. Same effective
# batch, LR schedule, and step count => equivalent optimization (see rebuttal notes).
# Consumed by: python train_peint_model.py --config configs/ablations/baseline.yaml
# Every ablation copies this file and changes ONLY its one axis, for a controlled comparison.

# --- data (lives outside rebuttal/; edit if your mirror differs) ---
data_path: /scratch/users/spa-evolution-yss/protevo/data/tr_rosetta/15k_gapless_scale_1024l
families_file: /scratch/users/spa-evolution-yss/protevo/data/tr_rosetta/14k5_fam.json
output_dir: /scratch/users/yufan.cao/protevo_ablations/baseline
n_families: -1
wandb_project: peint-ablations

# --- optimization ---
batch_size: 32
lr: 3.0e-4
weight_decay: 0.01
grad_clip: 1.0
accumulate_grad_batches: 12   # 2 GPUs -> keep 768-seq effective batch (32*12*2 = published 32*6*4)
max_steps: 300000
num_warmup_steps: 2000

# --- architecture (published PEINT) ---
esm_model: ESM2-150M       # saved as encoder_backbone
embed_dim: 640             # overridden to match the backbone anyway
num_heads: 20
num_encoder_layers: 5
num_decoder_layers: 5
max_seq_len: 1022
dropout_p: 0.0
use_attention_bias: true

# --- ablation axes (defaults = published behavior) ---
mlm_weight: 1.0
esm_finetune_mode: frozen
architecture: encoder_decoder
mask_prob: 0.15

# --- runtime / bookkeeping ---
seed: 0
accelerator: gpu
devices: [0, 1]
checkpoint_every: 4000
name_addon: baseline
